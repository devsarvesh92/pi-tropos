      "node_modules/pi-smritikosh/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "bundledDependencies": [
    "pi-smritikosh"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "pi-smritikosh": "^0.2.3"
  }
}
