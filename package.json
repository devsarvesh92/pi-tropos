{
  "name": "oh-my-pi",
  "version": "0.2.0",
  "description": "Personal pi customization bundle — context-health indicator, session handoff, session browser",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src"
  ],
